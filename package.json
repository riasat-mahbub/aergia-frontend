{
  "name": "aergia-desktop",
  "version": "0.1.0",
  "description": "Aergia Desktop App - Resume Builder",
  "type": "module",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:electron": "tsc -p tsconfig.electron.json && tsc -p tsconfig.preload.json",
    "preview": "vite preview",
    "electron": "npm run build:electron && electron .",
    "electron:dev": "concurrently \"npm run dev\" \"npm run build:electron && wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && npm run build:electron && electron-builder"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/react": "^0.27.13",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.14",
    "@react-pdf/renderer": "^4.3.0",
    "@reduxjs/toolkit": "^2.8.2",
    "@tiptap/extension-image": "^3.0.7",
    "@tiptap/extension-list": "^3.0.7",
    "@tiptap/extension-placeholder": "^3.7.2",
    "@tiptap/pm": "^3.0.7",
    "@tiptap/react": "^3.0.7",
    "@tiptap/starter-kit": "^3.0.7",
    "dompurify": "^3.2.6",
    "electron-store": "^11.0.2",
    "lucide-react": "^0.525.0",
    "motion": "^12.23.24",
    "react": "^19.1.0",
    "react-collapsed": "^4.2.0",
    "react-dom": "^19.1.0",
    "react-dropzone": "^14.3.8",
    "react-hotkeys-hook": "^5.1.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^6.22.0",
    "react-textarea-autosize": "^8.5.9",
    "react-to-print": "^3.1.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "sass": "^1.89.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  }
}
