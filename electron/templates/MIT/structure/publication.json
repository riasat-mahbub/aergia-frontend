{
  "type": "Div",
  "style": ".container",
  "children": [
    {
      "type": "Div",
      "style": ".titleRow",
      "children": [
        {
          "type": "Text",
          "style": ".title",
          "bind": "data.title"
        },
        {
          "type": "Date",
          "style": ".date",
          "startDate": "data.publicationDate",
          "endDate": "data.publicationDate",
          "if": "data.publicationDate"
        }
      ]
    },
    {
      "type": "Text",
      "style": ".subtitle",
      "bind": "data.publisher"
    },
    {
      "type": "Html",
      "style": ".description",
      "bind": "data.description"
    }
  ]
}
