{
  "type": "Div",
  "style": ".container",
  "children": [
    {
      "type": "Text",
      "style": ".title",
      "bind": "data.title"
    },
    {
      "type": "Date",
      "style": ".date",
      "startDate": "data.startDate",
      "endDate": "data.endDate",
      "if": "data.startDate"
    },
    {
      "type": "Text",
      "style": ".subtitle",
      "bind": "data.subtitle"
    },
    {
      "type": "Text",
      "style": ".location",
      "bind": "data.location"
    },
    {
      "type": "Html",
      "style": ".description",
      "bind": "data.description"
    }
  ]
}
